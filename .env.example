# RapidGate 环境变量示例
# 复制为 .env 并填入真实值；.env 已在 .gitignore 中

# 网关监听地址
RGD_LISTEN=0.0.0.0:8080

# 运行环境：development | production
RGD_ENV=development

# 配置文件目录
RGD_CONFIG_DIR=./config

# 日志级别：trace | debug | info | warn | error
RGD_LOG_LEVEL=info
RGD_LOG_FORMAT=pretty

# 上游 Provider 凭据（仅占位，禁止填入真实值）
RGD_OPENAI_BASE_URL=https://api.openai.com
RGD_OPENAI_API_KEY=

# SSRF 防护：自定义 IP 黑名单（CIDR，逗号分隔）
RGD_IP_BLOCKLIST=

# admin token（阶段三启用）
RGD_ADMIN_TOKEN=
